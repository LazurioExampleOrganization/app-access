{
  "name": "pristupy-app-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --no-env-file run src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint",
    "check:prepared": "bun run src/prepared.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "lazurioexampleorganization-pristupy-v1",
      "title": "Přístupy",
      "company": "LazurioExampleOrganization",
      "module": "pristupy",
      "surface": "internal",
      "dev_script": "dev",
      "tags": [
        "pristupy"
      ],
      "listeners": [
        {
          "id": "app",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/healthz"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v1/package.json",
      "check_script": "check:prepared"
    }
  }
}
